{
    "name": "ginganomercy/guciravel",
    "description": "N+1 Query Healer for Laravel. Visual detection for development environments.",
    "keywords": ["laravel", "n-plus-one", "n1", "eager-loading", "query", "performance", "debug", "healer", "orm", "eloquent"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rafly A.R",
            "email": "raflypriyantoro@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/contracts": "^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ginganomercy\\Guciravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ginganomercy\\Guciravel\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ginganomercy\\Guciravel\\GuciravelServiceProvider"
            ]
        }
    }
}